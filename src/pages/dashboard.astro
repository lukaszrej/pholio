---
import Layout from "@/layouts/Layout.astro";
import DashboardView from "@/components/transactions/DashboardView";
import { createClient } from "@/lib/supabase";
import { refreshPricesForTickers } from "@/lib/prices";
import { refreshSectorsForTickers } from "@/lib/sectors";
import type { PriceData } from "@/lib/portfolio";
import type { Transaction } from "@/types/transaction";
import type { Portfolio } from "@/types/portfolio";
const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase
  ? await supabase.from("transactions").select("*").order("purchase_date", { ascending: false }).limit(500)
  : null;
if (result?.error) {
  // eslint-disable-next-line no-console
  console.error("[dashboard] failed to load transactions", result.error.message);
}
const transactions = (result?.data ?? []) as Transaction[];

const { data: portfoliosData, error: portfoliosError } = supabase
  ? await supabase.from("portfolios").select("*").order("created_at", { ascending: true })
  : { data: [], error: null };
if (portfoliosError) {
  // eslint-disable-next-line no-console
  console.error("[dashboard] failed to load portfolios", portfoliosError.message);
}

const uniqueTickers = [...new Set(transactions.map((t) => t.ticker.toUpperCase()))];
const prices: Record<string, PriceData> = supabase ? await refreshPricesForTickers(uniqueTickers, supabase) : {};

const sectorProfiles = supabase ? await refreshSectorsForTickers(uniqueTickers, supabase) : {};
const sectors: Record<string, string> = {};
for (const [ticker, profile] of Object.entries(sectorProfiles)) {
  sectors[ticker] = profile.sector ?? "Other";
}
---

<Layout title="Dashboard">
  <DashboardView
    client:load
    initialTransactions={transactions}
    initialPrices={prices}
    initialSectors={sectors}
    initialPortfolios={(portfoliosData ?? []) as Portfolio[]}
    userEmail={user?.email}
  />
</Layout>
