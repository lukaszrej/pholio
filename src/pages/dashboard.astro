---
import Layout from "@/layouts/Layout.astro";
import DashboardView from "@/components/transactions/DashboardView";
import { createClient } from "@/lib/supabase";
import { fetchQuote } from "@/lib/finnhub";
import type { PriceData } from "@/lib/portfolio";
import type { Transaction } from "@/types/transaction";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase
  ? await supabase.from("transactions").select("*").order("purchase_date", { ascending: false })
  : null;
const transactions = (result?.data ?? []) as Transaction[];

const today = new Date().toISOString().split("T")[0];
const uniqueTickers = [...new Set(transactions.map((t) => t.ticker.toUpperCase()))];
const prices: Record<string, PriceData> = {};

if (supabase && uniqueTickers.length > 0) {
  const sb = supabase;
  const { data: cachedRows } = await sb.from("prices").select("*").in("ticker", uniqueTickers);
  const cacheMap = new Map<string, { price: number; fetched_at: string }>();
  for (const row of (cachedRows ?? []) as { ticker: string; price: number; fetched_at: string }[]) {
    cacheMap.set(row.ticker, { price: row.price, fetched_at: row.fetched_at });
  }

  await Promise.allSettled(
    uniqueTickers.map(async (ticker) => {
      const cached = cacheMap.get(ticker);
      if (cached?.fetched_at.split("T")[0] === today) {
        prices[ticker] = { price: cached.price, fetched_at: cached.fetched_at, is_fresh: true };
        return;
      }

      const quote = await fetchQuote(ticker);
      if (quote !== null) {
        const fetched_at = new Date().toISOString();
        const { error: upsertErr } = await sb.from("prices").upsert({ ticker, price: quote, fetched_at });
        if (upsertErr) console.error("[prices] upsert failed", ticker, upsertErr.message);
        prices[ticker] = { price: quote, fetched_at, is_fresh: true };
      } else if (cached) {
        prices[ticker] = { price: cached.price, fetched_at: cached.fetched_at, is_fresh: false };
      }
    }),
  );
}
---

<Layout title="Dashboard">
  <DashboardView client:load initialTransactions={transactions} initialPrices={prices} userEmail={user?.email} />
</Layout>
