---
import Layout from "@/layouts/Layout.astro";
import DashboardView from "@/components/transactions/DashboardView";
import { createClient } from "@/lib/supabase";
import type { Transaction } from "@/types/transaction";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase
  ? await supabase.from("transactions").select("*").order("purchase_date", { ascending: false })
  : null;
const transactions = (result?.data ?? []) as Transaction[];
---

<Layout title="Dashboard">
  <DashboardView client:load initialTransactions={transactions} userEmail={user?.email} />
</Layout>
