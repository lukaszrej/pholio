---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in — Pholio">
  <div class="bg-cosmic flex min-h-screen justify-center px-6 pt-16 pb-6">
    <div class="w-full max-w-sm">
      <div class="mb-10 flex flex-col items-center gap-3 text-center">
        <svg width="48" height="48" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <rect width="22" height="22" rx="5" fill="url(#logo-grad-signin)"></rect>
          <rect x="5" y="5" width="5" height="12" rx="1.5" fill="rgba(255,255,255,0.9)"></rect>
          <rect x="12" y="9" width="5" height="8" rx="1.5" fill="rgba(255,255,255,0.6)"></rect>
          <defs>
            <linearGradient id="logo-grad-signin" x1="0" y1="0" x2="22" y2="22" gradientUnits="userSpaceOnUse">
              <stop stop-color="#c41230"></stop>
              <stop offset="1" stop-color="#8b0d21"></stop>
            </linearGradient>
          </defs>
        </svg>
        <span
          class="text-[30px] font-bold tracking-[-0.01em]"
          style="font-family: var(--font-serif); background: var(--gradient-wordmark); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
        >
          Pholio
        </span>
        <h1
          class="text-[clamp(26px,3.5vw,40px)] leading-snug font-bold tracking-[-0.02em] text-[var(--tl-tx)]"
          style="font-family: var(--font-serif);"
        >
          Track every position,<br />
          <em class="font-normal text-[var(--tl-cy)]">in one calm place.</em>
        </h1>
        <p class="text-sm leading-relaxed text-[var(--tl-mut)]">
          Multi-portfolio tracking with live P&L and a watchlist that moves with the market.
        </p>
      </div>
      <div class="rounded-md border border-[var(--tl-line)] bg-white p-6 shadow-sm">
        <h2 class="mb-1 text-xl font-semibold text-[var(--tl-tx)]">Sign in</h2>
        <p class="mb-4 text-sm text-[var(--tl-mut)]">Welcome back.</p>
        <div class="-mx-6 mb-5 h-px bg-[var(--tl-line)]"></div>
        <SignInForm serverError={error} client:load />
      </div>
      <p class="mt-5 text-center text-sm text-[var(--tl-mut)]">
        New here? <a href="/auth/signup" class="font-medium text-[var(--tl-cy)] hover:underline">Create an account</a>
      </p>
    </div>
  </div>
</Layout>
